//
// Assembler Executor Helper - Contains dynamically generated switch cases
// This file is generated by run_qcbench.sh and contains the execution logic for assemblers
//

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    IMPORT MODULES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Assembler imports - dynamically generated
// DYNAMIC_IMPORTS_START
include { FLYE } from '../../../modules/nf-core/flye/main'

// DYNAMIC_IMPORTS_END

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    FUNCTIONS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

//
// Execute assembler based on module name and configuration
// This function contains dynamically generated switch cases
//
def execute_assembler(ch_samplesheet, ch_mode, module_name, output_channel) {
    def ch_versions = Channel.empty()
    def ch_output = Channel.empty()

    switch(module_name) {
        // DYNAMIC_SWITCH_CASES_START
        case 'FLYE':
            FLYE(ch_samplesheet, ch_mode)
            ch_output = FLYE.out."${output_channel}"
            try {
                if (FLYE.out.versions) {
                    ch_versions = ch_versions.mix(FLYE.out.versions)
                }
            } catch (Exception e) {
                // Module doesn't have versions output - skip
            }
            break

        // DYNAMIC_SWITCH_CASES_END

        default:
            log.error "Assembler module '${module_name}' is not implemented in switch statement."
            error "Unsupported assembler module: ${module_name}"
    }

    return [ch_output, ch_versions]
}
